{
  "name": "qoder-openai-proxy",
  "version": "2.0.0",
  "description": "OpenAI-compatible API proxy for Qoder CLI",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test": "jest --forceExit",
    "test:e2e": "jest --testPathPattern=tests/e2e --forceExit",
    "test:e2e:setup": "docker compose -f examples/demo-project/docker-compose.yml --env-file examples/demo-project/.env up -d",
    "test:e2e:seed": "node examples/demo-project/seed/seed.js",
    "test:e2e:teardown": "docker compose -f examples/demo-project/docker-compose.yml --env-file examples/demo-project/.env down -v --remove-orphans"
  },
  "keywords": [
    "qoder",
    "openai",
    "proxy",
    "api",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "better-sqlite3": "^13.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^9.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^11.2.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "minio": "^8.0.0",
    "redis": "^4.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  }
}
